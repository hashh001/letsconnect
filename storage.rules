rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Profile Photos ────────────────────────────────────────────────────
    // PRIVACY FIX (VULN-7): Explicit rules now replace the Firebase Storage
    // default (which allows any authenticated user to read/write any path).
    //
    // Read:  any authenticated user may read a profile photo (needed to
    //        render other users' avatars in group views and public profiles).
    // Write: only the owning user may upload or delete their own photo.
    //        Upload path format: profile-photos/{uid}_{timestamp}.{ext}
    //        The filename MUST start with the authenticated user's UID.
    match /profile-photos/{filename} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null
                    && filename.matches(request.auth.uid + '_.*');
    }

    // ─── Deny everything else ──────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
